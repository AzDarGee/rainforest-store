<%= form_for @product do |f| %>
  <%= render 'errors' %>
  <div>
    <%= f.text_field "name", placeholder: "Name" %>
  </div>
  <div>
      <%= f.text_field "description", placeholder: "description" %>
  </div>
  <div>
      <%= f.text_field "price_in_cents", placeholder: "Price in cents" %>
  </div>
  <div>
    <%= f.submit "Save", class: 'button' %>
  </div>
<% end %>



