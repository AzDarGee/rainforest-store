<h1>Products</h1>

<%= form_tag products_path, method: :get, authentication: false, id: 'search-form' do %>
  <%= text_field_tag :search, params[:search] %>
  <%= submit_tag "Search", name: nil %>
<% end %>

<h3><%= link_to 'Add Product', new_product_path %></h3>

<ol id="products">
  <%= render @products %>
</ol>
