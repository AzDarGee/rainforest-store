<h2>Reviews</h2>
<% @product.reviews.each do |review| %>
  <div class="review">
    <div class="poster">
      <% if review.user != nil %>
        Posted by <%= review.user.email %> on <%= review.created_at %>
      <% end %>
    </div>
    <p class="comment">
      <%= review.comment %>
    </p>
  </div>
<% end %>